{
    "compilerOptions": {
        // These are CommonJS command line scripts executed by GitHub Actions with `node build/<x>.js`,
        // so the emit has to stay CommonJS - package.json deliberately has no "type": "module".
        // module/moduleResolution "node16" is the TypeScript 6 successor of the deprecated "node10":
        // it honours package.json "exports" and, because this package is not "type": "module",
        // still treats every .ts here as CommonJS and emits require()/module.exports.
        "target": "es2022",
        "module": "node16",
        "moduleResolution": "node16",
        "lib": ["es2022"],
        "types": ["node", "mocha"],

        "rootDir": "./src",
        "outDir": "./build",
        "sourceMap": true,

        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,

        // Pragmatic first migration: implicit any is flagged, but the remaining strict checks are
        // left off for now. Third party payloads (GitHub API, npm registry) are typed as `any` on
        // purpose - tightening those is follow-up work.
        "strict": false,
        "noImplicitAny": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "build"]
}
